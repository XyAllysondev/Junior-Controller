# ---------------------------------------------------------------
# Configuracao do backend - copie este arquivo para ".env"
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / Linux:    cp .env.example .env
# ---------------------------------------------------------------

# Porta em que a API vai rodar (so no modo local)
PORT=3333

# ---------------------------------------------------------------
# Banco de dados
#
# Sem as variaveis do Turso, o sistema usa um arquivo SQLite local -
# otimo para desenvolver. Com elas, usa o Turso (SQLite hospedado),
# que e o modo de producao.
# ---------------------------------------------------------------

# Caminho do arquivo SQLite local (relativo a pasta backend/)
DB_FILE=data/manutencao.db

# Turso - preencha em producao (Vercel > Settings > Environment Variables)
#   turso db show <nome> --url
#   turso db tokens create <nome>
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# ---------------------------------------------------------------
# Fuso horario da fabrica, em horas em relacao ao UTC.
# Servidor na nuvem roda em UTC; -3 e o horario de Brasilia
# (o Brasil nao usa mais horario de verao).
# ---------------------------------------------------------------
FUSO_HORARIO=-3

# ---------------------------------------------------------------
# Origens liberadas no CORS, separadas por virgula.
# Vazio = libera todas (util quando front e back estao no mesmo dominio).
# O Vite (frontend) sobe por padrao em 5173.
# ---------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Aplica automaticamente os arquivos de sql/ na primeira requisicao
AUTO_MIGRATE=true

# Popula o banco com dados de exemplo quando ele estiver vazio.
# Em producao, depois de cadastrar as maquinas de verdade, mude para false.
SEED_ON_EMPTY=true
