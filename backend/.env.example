# ---------------------------------------------------------------
# Configuracao do backend - copie este arquivo para ".env"
#   Windows PowerShell:  Copy-Item .env.example .env
#   Git Bash / Linux:    cp .env.example .env
# ---------------------------------------------------------------

# Porta em que a API vai rodar
PORT=3333

# Caminho do arquivo do banco SQLite (relativo a pasta backend/)
DB_FILE=data/manutencao.db

# Origens liberadas no CORS, separadas por virgula.
# O Vite (frontend) sobe por padrao em 5173.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Aplica automaticamente os arquivos de sql/ na subida do servidor
AUTO_MIGRATE=true

# Popula o banco com dados de exemplo quando ele estiver vazio
SEED_ON_EMPTY=true
