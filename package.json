{
  "name": "app-manutencao",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Capricche - Manutencao Eletrica: controle de manutencao de maquinas",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "seed": "npm run seed --workspace backend",
    "reset": "npm run reset --workspace backend",
    "verificar": "npm run build --workspace frontend && tsc --noEmit -p backend/tsconfig.json"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
